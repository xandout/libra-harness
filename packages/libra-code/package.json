{
  "name": "@xandout/libra-code",
  "version": "0.1.129",
  "description": "A code agent CLI powered by libra-harness. Install globally with: npm install -g @xandout/libra-code",
  "type": "module",
  "bin": {
    "lc": "dist/index.js",
    "cdp": "dist/src/cdp-entry.js"
  },
  "files": [
    "dist/index.js",
    "dist/index.js.map",
    "dist/index.d.ts",
    "dist/agent-setup.*",
    "dist/file-change-tracker.*",
    "dist/session-socket.*",
    "dist/session-stats.*",
    "dist/src/cdp-entry.*",
    "dist/src/cdp"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.36",
    "@ai-sdk/deepseek": "^3.0.36",
    "@ai-sdk/google": "^4.0.39",
    "@ai-sdk/openai": "^4.0.36",
    "@xandout/libra-harness": "link:../..",
    "diff": "^5.2.2"
  },
  "devDependencies": {
    "@types/diff": "^5.2.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xandout/libra-harness.git",
    "directory": "packages/libra-code"
  }
