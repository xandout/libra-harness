{
  "name": "@xandout/libra-code",
  "version": "0.1.101",
  "description": "A code agent CLI powered by libra-harness. Install globally with: npm install -g @xandout/libra-code",
  "type": "module",
  "bin": {
    "lc": "dist/index.js",
    "cdp": "bin/cdp",
    "screenshot": "bin/screenshot",
    "start-browser": "bin/start-browser"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx index.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.36",
    "@ai-sdk/deepseek": "^3.0.36",
    "@ai-sdk/google": "^4.0.39",
    "@ai-sdk/openai": "^4.0.36",
    "@xandout/libra-harness": "link:../..",
    "diff": "^5.2.2"
  },
  "devDependencies": {
    "@types/diff": "^5.2.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xandout/libra-harness.git",
    "directory": "packages/libra-code"
  }
}
