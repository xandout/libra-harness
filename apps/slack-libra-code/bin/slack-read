#!/usr/bin/env node
/**
 * slack-read — Read recent Slack messages from the current thread or channel.
 *
 * Standalone script with zero external dependencies (uses native fetch).
 *
 * Usage:
 *   slack-read [--channel <id>] [--thread <ts>] [--limit <number>]
 */

const token = process.env.SLACK_BOT_TOKEN;
if (!token) {
  console.error('Error: SLACK_BOT_TOKEN is not set.');
  process.exit(1);
}

const args = process.argv.slice(2);
let channel = process.env.SLACK_CHANNEL_ID;
let threadTs = process.env.SLACK_THREAD_TS || undefined;
let limit = 20;

for (let i = 0; i < args.length; i++) {
  if (args[i] === '--channel' && args[i + 1]) channel = args[++i];
  else if (args[i] === '--thread' && args[i + 1]) threadTs = args[++i];
  else if (args[i] === '--limit' && args[i + 1]) limit = parseInt(args[++i], 10);
}

if (!channel) {
  console.error('Error: Slack channel not specified and SLACK_CHANNEL_ID is not set.');
  process.exit(1);
}

try {
  const endpoint = threadTs ? 'conversations.replies' : 'conversations.history';
  const url = new URL(`https://slack.com/api/${endpoint}`);
  url.searchParams.set('channel', channel);
  url.searchParams.set('limit', String(limit));
  if (threadTs) {
    url.searchParams.set('ts', threadTs);
  }

  const res = await fetch(url.toString(), {
    method: 'GET',
    headers: {
      Authorization: `Bearer ${token}`,
      'Content-Type': 'application/json; charset=utf-8',
    },
  });

  const data = await res.json();
  if (!data.ok) {
    throw new Error(data.error || `HTTP ${res.status}`);
  }

  for (const msg of data.messages || []) {
    console.log(`[${msg.user || 'bot'} @ ${msg.ts}]: ${msg.text || ''}`);
  }
} catch (err) {
  console.error('Failed to read Slack conversation:', err.message || err);
  process.exit(1);
}
