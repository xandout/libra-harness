{
  "name": "@xandout/libra-harness",
  "version": "0.1.118",
  "description": "A small, composable, hookable agent harness. Library-first.",
  "repository": {
    "type": "git",
    "url": "https://github.com/xandout/libra-harness"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./extensions": {
      "types": "./dist/extensions/index.d.ts",
      "import": "./dist/extensions/index.js"
    },
    "./extensions/loader": {
      "types": "./dist/extensions/loader.d.ts",
      "import": "./dist/extensions/loader.js"
    },
    "./models": {
      "types": "./dist/models/index.d.ts",
      "import": "./dist/models/index.js"
    },
    "./models/ai-sdk-resolver": {
      "types": "./dist/models/ai-sdk-resolver.d.ts",
      "import": "./dist/models/ai-sdk-resolver.js"
    },
    "./models/routing-model": {
      "types": "./dist/models/routing-model.d.ts",
      "import": "./dist/models/routing-model.js"
    },
    "./openai-provider": {
      "types": "./dist/openai-provider/index.d.ts",
      "import": "./dist/openai-provider/index.js"
    },
    "./extensions/logger": {
      "types": "./dist/extensions/logger/index.d.ts",
      "import": "./dist/extensions/logger/index.js"
    },
    "./extensions/disk-session": {
      "types": "./dist/extensions/disk-session/index.d.ts",
      "import": "./dist/extensions/disk-session/index.js"
    },
    "./extensions/mem-session": {
      "types": "./dist/extensions/mem-session/index.d.ts",
      "import": "./dist/extensions/mem-session/index.js"
    },
    "./extensions/timestamp": {
      "types": "./dist/extensions/timestamp/index.d.ts",
      "import": "./dist/extensions/timestamp/index.js"
    },
    "./extensions/emoji": {
      "types": "./dist/extensions/emoji/index.d.ts",
      "import": "./dist/extensions/emoji/index.js"
    },
    "./extensions/weather-tool": {
      "types": "./dist/extensions/weather-tool/index.d.ts",
      "import": "./dist/extensions/weather-tool/index.js"
    },
    "./extensions/code-tools": {
      "types": "./dist/extensions/code-tools/index.d.ts",
      "import": "./dist/extensions/code-tools/index.js"
    },
    "./extensions/streaming": {
      "types": "./dist/extensions/streaming/index.d.ts",
      "import": "./dist/extensions/streaming/index.js"
    },
    "./extensions/structured-output": {
      "types": "./dist/extensions/structured-output/index.d.ts",
      "import": "./dist/extensions/structured-output/index.js"
    },
    "./extensions/mcp": {
      "types": "./dist/extensions/mcp/index.d.ts",
      "import": "./dist/extensions/mcp/index.js"
    },
    "./extensions/skills": {
      "types": "./dist/extensions/skills/index.d.ts",
      "import": "./dist/extensions/skills/index.js"
    },
    "./extensions/auto-steer": {
      "types": "./dist/extensions/auto-steer/index.d.ts",
      "import": "./dist/extensions/auto-steer/index.js"
    },
    "./extensions/filesystem": {
      "types": "./dist/extensions/filesystem/index.d.ts",
      "import": "./dist/extensions/filesystem/index.js"
    },
    "./extensions/keyword-extractor": {
      "types": "./dist/extensions/keyword-extractor/index.d.ts",
      "import": "./dist/extensions/keyword-extractor/index.js"
    },
    "./extensions/otel": {
      "types": "./dist/extensions/otel/index.d.ts",
      "import": "./dist/extensions/otel/index.js"
    },
    "./extensions/tool-buffer": {
      "types": "./dist/extensions/tool-buffer/index.d.ts",
      "import": "./dist/extensions/tool-buffer/index.js"
    },
    "./extensions/token-stats": {
      "types": "./dist/extensions/token-stats/index.d.ts",
      "import": "./dist/extensions/token-stats/index.js"
    },
    "./extensions/scripts": {
      "types": "./dist/extensions/scripts/index.d.ts",
      "import": "./dist/extensions/scripts/index.js"
    },
    "./skills": {
      "types": "./dist/extensions/skills/index.d.ts",
      "import": "./dist/extensions/skills/index.js"
    },
    "./code-tools": {
      "types": "./dist/extensions/code-tools/index.d.ts",
      "import": "./dist/extensions/code-tools/index.js"
    },
    "./disk-session": {
      "types": "./dist/extensions/disk-session/index.d.ts",
      "import": "./dist/extensions/disk-session/index.js"
    },
    "./streaming": {
      "types": "./dist/extensions/streaming/index.d.ts",
      "import": "./dist/extensions/streaming/index.js"
    },
    "./mcp": {
      "types": "./dist/extensions/mcp/index.d.ts",
      "import": "./dist/extensions/mcp/index.js"
    },
    "./logger": {
      "types": "./dist/extensions/logger/index.d.ts",
      "import": "./dist/extensions/logger/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && for d in src/extensions/*/; do name=$(basename \"$d\") && if [ -f \"$d\"extension.json ]; then cp \"$d\"extension.json dist/extensions/\"$name\"/; fi; done",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:outdated": "pnpm outdated --format list",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "agent",
    "llm",
    "hooks",
    "library",
    "ai"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "fallow": "^3.22.0",
    "quickjs-emscripten": "^0.32.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "ai": "^7.0.0",
    "quickjs-emscripten": "^0.32.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "@modelcontextprotocol/client": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-base": {
      "optional": true
    },
    "quickjs-emscripten": {
      "optional": true
    }
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.36",
    "@ai-sdk/deepseek": "^3.0.36",
    "@ai-sdk/google": "^4.0.39",
    "@ai-sdk/openai": "^4.0.36",
    "@ai-sdk/provider": "^4.0.7",
    "wink-eng-lite-web-model": "^1.8.1",
    "wink-nlp": "^2.4.0"
  }
}
