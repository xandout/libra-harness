{
  "name": "@xandout/libra-harness",
  "version": "0.1.129",
  "description": "A small, composable, hookable agent harness. Library-first.",
  "repository": {
    "type": "git",
    "url": "https://github.com/xandout/libra-harness"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./models": {
      "types": "./dist/models/index.d.ts",
      "import": "./dist/models/index.js"
    },
    "./extensions/disk-session": {
      "types": "./dist/extensions/disk-session/index.d.ts",
      "import": "./dist/extensions/disk-session/index.js"
    },
    "./extensions/code-tools": {
      "types": "./dist/extensions/code-tools/index.d.ts",
      "import": "./dist/extensions/code-tools/index.js"
    },
    "./extensions/streaming": {
      "types": "./dist/extensions/streaming/index.d.ts",
      "import": "./dist/extensions/streaming/index.js"
    },
    "./extensions/skills": {
      "types": "./dist/extensions/skills/index.d.ts",
      "import": "./dist/extensions/skills/index.js"
    }
  },
  "files": [
    "dist/*.js",
    "dist/*.js.map",
    "dist/*.d.ts",
    "dist/*.d.ts.map",
    "dist/models",
    "dist/extensions/code-tools",
    "dist/extensions/disk-session",
    "dist/extensions/skills",
    "dist/extensions/streaming",
    "!dist/**/*.test.*",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && for d in src/extensions/*/; do name=$(basename \"$d\") && if [ -f \"$d\"extension.json ]; then cp \"$d\"extension.json dist/extensions/\"$name\"/; fi; done && cp src/extensions/code-tools/tools/task-wrapper.sh dist/extensions/code-tools/tools/task-wrapper.sh && chmod +x dist/extensions/code-tools/tools/task-wrapper.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:outdated": "pnpm outdated --format list",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "agent",
    "llm",
    "hooks",
    "library",
    "ai"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.36",
    "@ai-sdk/deepseek": "^3.0.36",
    "@ai-sdk/google": "^4.0.39",
    "@ai-sdk/openai": "^4.0.36",
    "@ai-sdk/provider": "^4.0.7",
    "ai": "^7.0.84"
  }
}
