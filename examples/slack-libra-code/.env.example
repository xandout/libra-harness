# Slack tokens (from https://api.slack.com/apps → your app)
# Socket Mode must be enabled on the app
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-level-token-here

# Model provider API key (used by lc)
DEEPSEEK_API_KEY=your-deepseek-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# GOOGLE_GENERATIVE_AI_API_KEY=your-google-api-key-here

# LC_SOURCE: path, URL, or npm package (default: ../../extras/libra-code)
# Examples:
#   LC_SOURCE=../../extras/libra-code
#   LC_SOURCE=@xandout/libra-code
#   LC_SOURCE=https://github.com/xandout/libra-harness/archive/refs/heads/main.tar.gz
LC_SOURCE=../../extras/libra-code

# Target working directory where lc will run (defaults to current directory)
# This is the directory whose code lc will inspect/edit, and where AGENTS.md is loaded.
# LC_CWD=/path/to/project

# Optional: restrict bot to a specific channel (channel ID like C12345678)
# SLACK_CHANNEL=C12345678
