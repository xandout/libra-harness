{
  "name": "libra-example-slack-bot",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node index.ts",
    "dev": "tsx watch index.ts",
    "typecheck": "tsc --noEmit",
    "report": "tsx trace-report.ts",
    "report:csv": "tsx trace-report.ts -- --csv",
    "report:tools": "tsx trace-report.ts -- --tools",
    "report:tokens": "tsx trace-report.ts -- --tokens",
    "report:sessions": "tsx trace-report.ts -- --sessions"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.202.0",
    "@opentelemetry/sdk-node": "^0.202.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@slack/bolt": "^5.0.0",
    "@slack/web-api": "^8.0.0",
    "ai": "^7.0.0",
    "@xandout/libra-harness": "link:../..",
    "quickjs-emscripten": "^0.32.0",
    "slackify-markdown": "^5.0.0"
  },
  "devDependencies": {
    "tsx": "^4.0.0",
    "typescript": "^7.0.2"
  }
}
