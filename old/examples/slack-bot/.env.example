# Slack tokens (from https://api.slack.com/apps → your app)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-level-token-here

# Optional: user or app token for search (read-only — doesn't post as you)
# Requires search:read scope. Without this, search tools are not available.
# SLACK_SEARCH_TOKEN=xoxp-your-user-token-here

# Optional: directory for disk-backed session files (default: ./sessions)
# Each session (DM/thread) is stored as a JSON file with conversation
# history, Slack metadata, and tool call records.
# SLACK_SESSION_DIR=./sessions

# Native model provider and credentials
MODEL=deepseek/deepseek-v4-flash
DEEPSEEK_API_KEY=your-deepseek-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# GOOGLE_GENERATIVE_AI_API_KEY=your-google-api-key-here

# Maximum number of agent iterations before giving up
MAX_ITERATIONS=5

# Optional: restrict to a single channel (channel ID or name)
# SLACK_CHANNEL=C12345678

# Slack MCP (optional — copy mcpServers.example.json → mcpServers.json
# and replace the token with your Slack user token xoxp-...)
# See https://docs.slack.dev/ai/slack-mcp-server for setup.

# OpenTelemetry (optional — traces for agent turns, LLM calls, tool calls)
# Set to false to disable tracing entirely.
# OTEL_ENABLED=false
# Service name shown in trace dashboards (default: libra-slack-bot)
# OTEL_SERVICE_NAME=libra-slack-bot
# Directory for JSONL trace files (default: ./traces)
# OTEL_TRACE_DIR=./traces
# OTLP endpoint for exporting traces (Jaeger, Honeycomb, Datadog, Tempo, etc.)
# If not set, spans are written to ./traces/traces.jsonl
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# Record tool call arguments in span attributes (may contain sensitive data)
# OTEL_RECORD_TOOL_ARGS=true

